# --- OS & IDE ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.settings/
.classpath
.project
.factorypath
.springBeans
.sts4-cache
.metadata/
.gradle/
.nb-gradle/
.apt_generated
*.iml
*.iws
